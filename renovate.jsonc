// Dependency updates, as pull requests that CI has already judged.
//
// JSONC rather than JSON so this can be commented, which matters here because
// several settings below are switched on to work around a default that
// silently does nothing. Renovate accepts .json5 too, but its docs name
// .jsonc as the one to reach for when you want comments.
//
// At the repository root rather than under .github/: both are supported, and
// the root filenames come first in Renovate's search order.
//
// Renovate runs self-hosted, from .github/workflows/renovate.yml, as the
// repository's own GitHub App rather than Mend's hosted one. The reason is
// postUpgradeTasks below: they run commands after an update, which is how a
// PR that changes flake.nix arrives with a flake.lock to match, and the
// hosted app does not allow them. Settings that only a self-hosted Renovate
// accepts — which commands may run, which repositories to visit — are in
// .github/renovate-global.js; this file is the per-repository part.
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended",

    // Rewrites every `uses:` in .github/workflows from a tag to the commit
    // SHA it resolves to, keeping the tag as a trailing comment, and
    // maintains it from then on. Tags are mutable: tj-actions/changed-files
    // had all of its rewritten to malicious commits in March 2025. Doing this
    // through a preset rather than by hand also means an action added later
    // gets pinned without anyone remembering to.
    "helpers:pinGitHubActionDigests",

    // Updates `FOO_VERSION:` values in workflow files that carry a
    // `# renovate: datasource=… depName=…` comment — here the Renovate
    // version in .github/workflows/renovate.yml, so the bot keeps itself
    // current like everything else.
    "customManagers:githubActionsVersions"
  ],

  // Schedules, should any come back, are read in this zone rather than UTC.
  "timezone": "Europe/Berlin",

  // The nix manager is in beta and ships disabled. Without this, Renovate
  // runs happily and never touches flake.nix or flake.lock at all — it is a
  // silent no-op, not an error.
  "nix": {
    "enabled": true
  },

  // And this is the second half of the same trap: lockFileMaintenance is off
  // by default and config:recommended does not turn it on, so even with the
  // nix manager enabled flake.lock would never move. This is the setting that
  // runs `nix flake update` and opens one PR with every input at its head —
  // the automated form of what was previously done by hand.
  //
  // Not scoped under `nix` because flake.lock is the only lock file in the
  // repository; if another ever appears, scope it then.
  //
  // "at any time" because the workflow's daily cron is the one place that
  // decides when Renovate runs. lockFileMaintenance otherwise falls back to
  // its own default of Monday mornings, even with no schedule set here. The
  // workflow narrows it all the same: runs started by a push or by CI
  // finishing open no new PR, this one included (RENOVATE_MODE in
  // renovate.yml).
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["at any time"]
  },

  // Every PR is rebuilt once it falls behind main, not only when it
  // conflicts. The default ("auto") rebases on a mere lag only with automerge
  // or a branch protection rule requiring up-to-date branches, and this
  // repository has neither, so an open PR never moves: lock PR #14 sat at its
  // first refresh for a week of nightly runs (2026-10-09 to 10-16), and the
  // Harlequin bump in PR #32 stayed on a main without the #33 lock refresh
  // (2026-10-28). Rebuilt, a PR's CI and closure-diff comment show what
  // merging would bring today, and lock file maintenance runs `nix flake
  // update` afresh — at most once per Renovate run, not once per push. Set
  // for every PR in a work repo, too. With automerge (below) the default
  // would now do the same; kept explicit so it does not hinge on that, and
  // so what is merged was tested on the main it lands on.
  "rebaseWhen": "behind-base-branch",

  // No Dependency Dashboard. Runs are started by the workflow — nightly, or
  // by hand with `gh workflow run renovate.yml` — and the PRs themselves are
  // the record of what is pending. What this gives up: a run's warnings
  // (a rejected postUpgradeTask, a config problem) no longer surface as an
  // issue, only in the run's log.
  "dependencyDashboard": false,

  // Flake inputs pinned to a release tag (none at present; aoe was the
  // last, removed 2026-10-06). The nix manager above
  // cannot bump these: it reads inputs from flake.lock and gives every one
  // but nixpkgs a locked commit and no version, so it has nothing to compare
  // a newer tag against — and lockFileMaintenance re-resolves the same tag to
  // the same commit. The first manager reads the tag straight out of the URL
  // instead and asks GitHub for newer ones. (renovate#45258 would teach the
  // nix manager this; once it lands, the first entry can go.)
  //
  // The second keeps the Harlequin adapters in home/max/core/harlequin-adapters.json
  // on PyPI's latest release.
  //
  // Neither has an artifact step of its own — a regex manager only edits
  // text — which is what the postUpgradeTasks in packageRules supply.
  // Grafana dashboards from grafana.com (modules/base/observability). Renovate
  // has no datasource for them, so this one maps a dashboard's revision list
  // onto versions: each revision is a whole number, published with a date.
  "customDatasources": {
    "grafana-dashboards": {
      "defaultRegistryUrlTemplate": "https://grafana.com/api/dashboards/{{packageName}}/revisions",
      "transformTemplates": [
        "{ \"releases\": [ items.{ \"version\": $string(revision), \"releaseTimestamp\": createdAt } ] }"
      ]
    }
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "Release tags in github: flake input URLs",
      "managerFilePatterns": ["/(^|/)flake\\.nix$/"],
      "matchStrings": [
        "url = \"github:(?<depName>[^/\"]+/[^/\"]+)/(?<currentValue>v\\d+\\.\\d+\\.\\d+)\";"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Harlequin adapters pinned from PyPI",
      "managerFilePatterns": ["/(^|/)harlequin-adapters\\.json$/"],
      "matchStrings": [
        "\"(?<depName>[A-Za-z0-9_.-]+)\":\\s*\\{[^}]*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Grafana dashboards pinned from grafana.com",
      "managerFilePatterns": ["/(^|/)upstream-dashboards\\.json$/"],
      "matchStrings": [
        "\"(?<depName>\\d+)\":\\{[^}]*\"revision\":(?<currentValue>\\d+)"
      ],
      "datasourceTemplate": "custom.grafana-dashboards",
      "versioningTemplate": "loose"
    }
  ],

  "packageRules": [
    {
      // Every version bump in one PR; lock file maintenance stays its own
      // weekly PR (Renovate always gives it a separate branch anyway). The
      // two carry very different risk: a tag or adapter bump touches one
      // package and CI is good evidence for it, while the lock refresh moves
      // all of nixpkgs and needs the local render suites. Kept apart, a small
      // bump never waits on the big one, and a breakage points at one of
      // them. The update types are listed so the lock refresh is not swept
      // into this group.
      //
      // The topic and extra are pinned so the PR is "Update dependencies"
      // however many updates it holds. Renovate otherwise titles a group with
      // a single update as if ungrouped ("Update dependency harlequin_mysql to
      // v1.5.0", PR #32) and only switches to the group name from two on, so
      // the same branch kept changing name. What is in it is in the PR body's
      // table either way.
      "description": "All version bumps in one PR",
      "commitMessageTopic": "dependencies",
      "commitMessageExtra": "",
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "rollback",
        "bump",
        "replacement"
      ],
      "groupName": "dependencies",
      // Needed for automerge because the title is pinned: Renovate looks for
      // an earlier PR with this branch and title, and finding one merged it
      // turns automerge off for the new one ("Disabling automerge because PR
      // was merged previously"). With a title that never changes, that is
      // every PR after the first. "always" skips the lookup, as Renovate
      // itself does for lock file maintenance. The price: a PR closed by hand
      // comes back on the next run.
      "recreateWhen": "always"
    },
    {
      // Everything pinned in a workflow file: action SHAs, Renovate's own
      // image, any other tool version. None of it can change what the machine
      // is built from, only the pipeline, so it is read differently from a
      // version bump and need not be current to the day. Matched by file so a
      // pin added later is covered whichever manager finds it (the image comes
      // from a regex manager, not github-actions).
      //
      // Renovate releases on every merged fix or feature, 3 to 13 times a day
      // (2026-10-08 to 10-21), so with the nightly run the pin in
      // .github/workflows/renovate.yml moved almost every night; Mondays only
      // (Europe/Berlin, which the 02:17 UTC run always falls on).
      //
      // Its own group because a schedule cannot be set per update inside one:
      // a branch takes its config from whichever upgrade sorts first, so in
      // "dependencies" this would either hold back every other bump or be
      // ignored. updateNotScheduled false so an open PR also waits for
      // Monday, instead of following each new release until then.
      //
      // The topic is set because the rule above pins it to "dependencies" for
      // every update type: the image alone, in a group then named "renovate",
      // came out as a second "Update dependencies" beside the action bump in
      // the first (PRs #56 and #57, 2026-11-09). This one is "Update CI".
      "description": "Workflow pins weekly, in their own PR",
      "matchFileNames": [".github/workflows/**"],
      "groupName": "ci",
      "commitMessageTopic": "CI",
      // For automerge, as in the rule above.
      "recreateWhen": "always",
      "schedule": ["* * * * 1"],
      "updateNotScheduled": false
    },
    {
      // A new tag in flake.nix leaves flake.lock on the old commit. `nix
      // flake lock` re-resolves only inputs whose URL changed.
      //
      // `update` mode, not `branch`, here and below: a branch-mode task is
      // taken from the branch's merged config, so in the grouped PR above
      // only one of the two would run. Per update, each runs its own; both
      // are idempotent, so running one twice changes nothing.
      //
      // Two --extra-experimental-features rather than one quoted
      // 'nix-command flakes': Renovate runs these without a shell, so there
      // is nothing to honour the quotes. The exact string is allow-listed in
      // .github/renovate-global.js.
      "description": "Relock after a flake input tag bump",
      "matchFileNames": ["flake.nix"],
      "matchDatasources": ["github-tags"],
      "postUpgradeTasks": {
        "commands": [
          "nix --extra-experimental-features nix-command --extra-experimental-features flakes flake lock"
        ],
        "fileFilters": ["flake.lock"],
        "installTools": { "nix": {} },
        "executionMode": "update"
      }
    },
    {
      // A new version leaves the old sdist hash beside it, which would fail
      // the build. The script refetches every pinned sdist and rewrites the
      // hashes from the versions now in the file.
      "description": "Rehash after a Harlequin adapter bump",
      "matchFileNames": ["home/max/core/harlequin-adapters.json"],
      "postUpgradeTasks": {
        "commands": ["scripts/renovate-pypi-rehash"],
        "fileFilters": ["home/max/core/harlequin-adapters.json"],
        "installTools": { "nix": {} },
        "executionMode": "update"
      }
    },
    {
      // Likewise for a dashboard: the new revision is a new file.
      "description": "Rehash after a Grafana dashboard bump",
      "matchFileNames": ["modules/base/observability/upstream-dashboards.json"],
      "postUpgradeTasks": {
        "commands": ["scripts/renovate-grafana-rehash"],
        "fileFilters": ["modules/base/observability/upstream-dashboards.json"],
        "installTools": { "nix": {} },
        "executionMode": "update"
      }
    }
  ],

  // Every PR is merged once all of its checks are green, Renovate's own
  // included: a PR whose lock file could not be regenerated has a failing
  // `renovate/artifacts` and stays open. The workflow starts a run whenever
  // CI finishes on a Renovate PR, which is the run that merges it.
  //
  // What this gives up, knowingly (off until 2026-11-10 for this reason): a
  // green `checks / portable` proves the machine builds, boots and has its
  // software, and proves nothing about what is on screen — the GPU tier
  // cannot run on a hosted runner. An update that breaks the greeter passes
  // CI and is merged; the render suites then find it on main, locally.
  "automerge": true,

  // Renovate does the merging itself, on the run that finds the checks green:
  // GitHub's own auto-merge needs a branch protection rule to wait on, and
  // there is none. A merge commit, as the PRs merged by hand have been;
  // left to choose, Renovate would rebase.
  "platformAutomerge": false,
  "automergeStrategy": "merge-commit"
}
